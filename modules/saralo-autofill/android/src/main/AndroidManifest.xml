<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name="app.saralo.autofill.SaraloAutofillService"
      android:label="Saralo"
      android:exported="true"
      android:permission="android.permission.BIND_AUTOFILL_SERVICE">
      <intent-filter>
        <action android:name="android.service.autofill.AutofillService" />
      </intent-filter>
      <meta-data android:name="android.autofill" android:resource="@xml/saralo_autofill" />
    </service>
    <activity
      android:name="app.saralo.autofill.AutofillAuthActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>
</manifest>
